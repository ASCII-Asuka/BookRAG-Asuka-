        "page_path": null,
        "pdf_id": 59,
        "pdf_para_block": null,
        "img_path": null,
        "image_width": 0,
        "image_height": 0,
        "caption": null,
        "footnote": null,
        "table_body": null,
        "content": "Author Contributions",
        "title_level": -1
      },
      "summary": ""
    },
    {
      "index_id": 60,
      "parent_id": 59,
      "type": "NodeType.TEXT",
      "meta_info": {
        "file_name": null,
        "file_path": null,
        "page_idx": 12,
        "page_path": null,
        "pdf_id": 60,
